<Project Sdk="Microsoft.NET.Sdk">
  <!-- Writes a real avatar pack from a synthetic rig with the software stick-figure renderer:
       the exporter's whole pipeline without Unity (tests/run_avatar_pipeline.sh). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>FactorioAvatarExporter.PackHarness</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Core/Core.csproj" />
  </ItemGroup>
</Project>
