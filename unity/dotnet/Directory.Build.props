<Project>
  <!-- Development builds of the exporter's Unity-free Core, outside Unity.
       Unity 2022.3 compiles the same sources with C# 9 against .NET Standard 2.1,
       so the Core project targets exactly that. -->
  <PropertyGroup>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <!-- Every NuGet package, with its content hash, is recorded in each project's packages.lock.json.
       On CI (GitHub Actions sets CI=true) a restore that would change a lock file fails instead, so a
       package can't change under the same version number. After changing a PackageReference, run
       dotnet restore here and commit the lock files; Dependabot updates them in its pull requests. -->
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>
</Project>
