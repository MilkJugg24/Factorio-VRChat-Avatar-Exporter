<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the Unity package's Core sources, which must not reference UnityEngine. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>FactorioAvatarExporter.Core</AssemblyName>
    <RootNamespace>FactorioAvatarExporter.Core</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Packages/com.vrcavatars.factorio-avatar-exporter/Core/**/*.cs" />
  </ItemGroup>
</Project>
